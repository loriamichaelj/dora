# Local development configuration (§9). Copy to .env: `cp .env.example .env`.
# These values are for localhost only. Never reuse them anywhere else.

# --- Database bootstrap (db container, first start on an empty volume only) ---
POSTGRES_PASSWORD=change-me
DORA_OWNER_PASSWORD=change-me
DORA_APP_PASSWORD=change-me

# --- Database connection (api, migrate, seed) ---
DB_HOST=db
DB_PORT=5432
DB_NAME=dora
DB_SSL_MODE=disable
DB_SSL_ROOT_CERT=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- API ---
# Ingest auth key: 32+ characters, or the API refuses to start.
# Generate a real one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=local-dev-ingest-key-change-me-0123456789
LOG_LEVEL=INFO
APP_ENV=local
ENABLE_API_DOCS=true
PORT=8000
# nginx reaches the api from a Compose network address, so trust any proxy
# locally (the api port is bound to 127.0.0.1 only). Phase B narrows this.
FORWARDED_ALLOW_IPS=*

# --- Host port mappings (compose, host side only) ---
WEB_PORT=8080
API_PORT=8000
DB_PORT_HOST=5432

# --- Self-tracking (scripts/record_deploy.py) ---
DORA_API_URL=http://localhost:8080
