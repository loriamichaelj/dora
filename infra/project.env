# Project-wide naming and region for Dora (docs/CLOUD-DEVOPS-DESIGN.md §5.5).
# Workflows load this file into their environment; Terraform receives the
# values as TF_VAR_* variables. This is the single place these names are set.
#
# The AWS account is shared (with Beacon), so every name must be unique to
# this project:
#   NAME_PREFIX      most resources: S3 buckets, ECR repositories, cluster,
#                    ALB/TG/RDS names, SSM paths, secrets, log groups, and the
#                    Project tag. Kept short because ALB and target group names
#                    max out at 32 characters.
#   IAM_NAME_PREFIX  IAM roles and policies. The account requires every IAM
#                    role name to start with "cloudbatch818-".
#   GITHUB_OIDC_SUB_PREFIX
#                    Start of the OIDC "sub" claim GitHub issues for this repo.
#                    The repo uses immutable subjects (owner@id/repo@id), so a
#                    deleted-and-recreated repo with the same name can't assume
#                    these roles. Full claim: <prefix>:environment:<name>.
#                    Check: gh api repos/loriamichaelj/dora/actions/oidc/customization/sub
#
# Every KEY=value here is exported to workflow steps as KEY and as
# TF_VAR_<key in lowercase>.

AWS_REGION=us-east-1
NAME_PREFIX=loria-dora
IAM_NAME_PREFIX=cloudbatch818-loria-dora
GITHUB_OIDC_SUB_PREFIX=repo:loriamichaelj@165821667/dora@1387517226
