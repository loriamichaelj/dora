# Environment for the isolated E2E stack (`make e2e`, Compose project dora-e2e).
# Test-only values: never used by the dev stack, and safe to commit.
# `make e2e` passes this with --env-file, so a developer's .env is never read.

POSTGRES_PASSWORD=e2e-postgres-password
DORA_OWNER_PASSWORD=e2e-owner-password
DORA_APP_PASSWORD=e2e-app-password
INGEST_API_KEY=e2e-ingest-key-0123456789abcdef0123456789

LOG_LEVEL=INFO
APP_ENV=e2e
ENABLE_API_DOCS=false
FORWARDED_ALLOW_IPS=*

# Different host ports, so the dev stack can keep running alongside.
WEB_PORT=18080
API_PORT=18000
DB_PORT_HOST=15432
